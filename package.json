{
  "name": "iilas",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build --config vite.config.ts",
    "start": "vite preview --config vite.config.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "functions:prepare": "node scripts/prepare-functions.mjs",
    "functions:install": "node scripts/install-functions.mjs",
    "emulators": "node scripts/prepare-functions.mjs && firebase emulators:start --project fyp-inventory-and-logistics --only auth,firestore,functions,storage",
    "test:smoke": "firebase emulators:exec --project fyp-inventory-and-logistics --only auth,firestore,functions,storage \"node scripts/smoke-firestore.mjs\"",
    "test:qa": "firebase emulators:exec --project fyp-inventory-and-logistics --only auth,firestore,functions,storage \"node scripts/qa-review.mjs\"",
    "test:shared": "firebase emulators:exec --project fyp-inventory-and-logistics --only auth,firestore,functions,storage \"node scripts/shared-qa.mjs\"",
    "test:capacity": "node scripts/capacity-qa.mjs",
    "test:dashboard": "node --experimental-strip-types scripts/dashboard-qa.mjs",
    "test:delivery-signals": "node --experimental-strip-types scripts/delivery-signals-qa.mjs",
    "test:parcel-capture": "node --experimental-strip-types --test scripts/parcel-capture-qa.mjs",
    "test:shipment-retry": "node --test scripts/shipment-retry-qa.mjs",
    "test:stock-client": "node scripts/stock-client-qa.mjs",
    "test:stock-retry": "firebase emulators:exec --project fyp-inventory-and-logistics --only auth,firestore,functions,storage \"node scripts/stock-retry-qa.mjs\"",
    "test:accounts": "firebase emulators:exec --project fyp-inventory-and-logistics --only auth,firestore,functions,storage \"node scripts/account-access-qa.mjs\"",
    "test:blockchain": "hardhat test",
    "blockchain:node": "hardhat node",
    "blockchain:deploy": "hardhat run blockchain/deploy.cjs --network localhost",
    "test:research": "python research/run_research_tests.py",
    "test:procurement-validation": "node scripts/procurement-validation-qa.mjs",
    "test:procurement": "firebase emulators:exec --project fyp-inventory-and-logistics --only auth,firestore,functions,storage \"node scripts/procurement-qa.mjs\"",
    "test:input-validation": "node scripts/input-validation-qa.mjs",
    "test:location-stock": "node scripts/location-stock-qa.mjs",
    "test:stock-locations": "firebase emulators:exec --project fyp-inventory-and-logistics --only auth,firestore,functions,storage \"node scripts/stock-locations-qa.mjs\"",
    "config:prepare": "node scripts/prepare-firebase-config.mjs",
    "predev": "npm run config:prepare",
    "prebuild": "npm run config:prepare",
    "security:scan": "node scripts/check-secrets.mjs",
    "security:history": "node scripts/check-secrets.mjs --history",
    "security:install-hooks": "git config --local core.hooksPath .githooks",
    "test:secrets": "node scripts/check-secrets-qa.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "ethers": "^6.17.0",
    "firebase": "^12.19.0",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^15.30.0",
    "hardhat": "^2.29.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "baseline-browser-mapping": "^2.11.0",
    "fast-uri": "^3.1.8",
    "source-map-js": "^1.2.2",
    "sharp": "0.35.5"
  }
}
