rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function approved(scope) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'Approved'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['Admin','Manager','Inventory','Warehouse','Logistics','Driver','Viewer']
        && firestore.get(/databases/(default)/documents/system/config).data.dataScopeId == scope;
    }
    function assigned(scope, shipment) {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role != 'Driver'
        || (firestore.get(/databases/(default)/documents/transportPlans/$(shipment)).data.ownerId == scope
          && firestore.get(/databases/(default)/documents/transportPlans/$(shipment)).data.driverUid == request.auth.uid);
    }
    function stageAllowed(scope, shipment) {
      let status = firestore.get(/databases/(default)/documents/shipments/$(shipment)).data.status;
      let role = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
      let meta = request.resource.metadata;
      return (meta.stage == 'Pre-dispatch' && status == 'Prepared'
          && role in ['Admin','Manager','Warehouse','Logistics'] && meta.evidenceType == 'Parcel Image')
        || (meta.stage == 'Delivery' && status == 'Dispatched'
          && role in ['Admin','Manager','Logistics','Driver'] && assigned(scope, shipment)
          && meta.evidenceType in ['Parcel Image','Proof of Delivery']);
    }
    function clientTime(value) {
      return timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10]))
        + duration.value(int(value[11:13]), 'h')
        + duration.value(int(value[14:16]), 'm')
        + duration.value(int(value[17:19]), 's')
        + duration.value(int(value[20:23]), 'ms');
    }
    function captureAllowed() {
      let meta = request.resource.metadata;
      return (meta.captureSource == 'file' && meta.get('capturedAtClient', '') == '')
        || (meta.captureSource == 'camera'
          && meta.capturedAtClient.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$')
          && clientTime(meta.capturedAtClient) <= request.time + duration.value(5, 'm'));
    }
    match /evidence/{scope}/{shipment}/{fileId} {
      allow read: if approved(scope);
      allow create: if approved(scope) && stageAllowed(scope, shipment) && resource == null
        && !firestore.exists(/databases/(default)/documents/evidence/$(fileId))
        && firestore.get(/databases/(default)/documents/shipments/$(shipment)).data.ownerId == scope
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(image/(jpeg|png|webp)|application/pdf)$')
        && (request.resource.metadata.evidenceType != 'Parcel Image' || request.resource.contentType.matches('^image/(jpeg|png|webp)$'))
        && captureAllowed()
        && request.resource.metadata.actor == request.auth.uid;
      allow update, delete: if false;
    }
    // Two distinct Firestore documents only: current user and fixed config.
    // Session/frame admission and create-only generation fencing are server-side.
    match /parcel-live/{scope}/{session}/{frame} {
      allow read: if approved(scope)
        && session.matches('^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$')
        && frame.matches('^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$');
      allow create, update, delete: if false;
    }
  }
}
